# ============================================================
# 🔒 Security Headers for Better Lighthouse & Best Practices
# ============================================================

# --- Content Security Policy (CSP) ---
# NOTE: 'unsafe-eval' is required for AdSense and some Google Analytics features
<IfModule mod_headers.c>
    Header set Content-Security-Policy \
        "default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval' \
            https: \
            http: \
            *.google.com \
            *.google-analytics.com \
            *.googletagmanager.com \
            *.googleadservices.com \
            *.googleapis.com \
            *.gstatic.com \
            *.doubleclick.net \
            *.googlesyndication.com \
            *.googleadservices.com \
            *.google-analytics.com \
            *.google.com \
            *.g.doubleclick.net \
            https://cdn.jsdelivr.net \
            https://cdnjs.cloudflare.com; \
        style-src 'self' 'unsafe-inline' \
            https: \
            http: \
            *.googleapis.com \
            *.gstatic.com \
            https://cdn.jsdelivr.net \
            https://cdnjs.cloudflare.com; \
        img-src 'self' data: https: http: \
            *.google.com \
            *.google-analytics.com \
            *.gstatic.com \
            *.googleadservices.com \
            *.doubleclick.net \
            *.googlesyndication.com; \
        font-src 'self' data: https: http: \
            *.gstatic.com \
            *.googleapis.com; \
        connect-src 'self' \
            https: \
            http: \
            *.google.com \
            *.google-analytics.com \
            *.doubleclick.net \
            *.googleadservices.com \
            *.googlesyndication.com; \
        frame-src 'self' \
            https: \
            http: \
            *.google.com \
            *.doubleclick.net \
            *.googlesyndication.com;"
</IfModule>

# --- HTTP Strict Transport Security (HSTS) ---
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# --- Cross-Origin Policies ---
<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    Header always set Cross-Origin-Embedder-Policy "unsafe-none"
    
    # Frame Protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # MIME Type Sniffing Protection
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Prevent indexing of components and static assets while allowing them to be crawled for rendering
    <FilesMatch "\.(html|php)$">
        SetEnvIf Request_URI "/components/" NOINDEX_FRAGMENT
        Header set X-Robots-Tag "noindex" env=NOINDEX_FRAGMENT
    </FilesMatch>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|pdf|xml|txt)$">
        Header set X-Robots-Tag "noindex"
    </FilesMatch>
</IfModule>

# --- Cache Control ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# --- Canonical Redirects: force HTTPS + non-WWW ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS and non-www to https://multitoolszone.fun/
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.multitoolszone\.fun$ [NC]
    RewriteRule ^(.*)$ https://multitoolszone.fun/$1 [R=301,L]

    # Redirect /index.html to /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
    RewriteRule ^index\.html$ / [R=301,L]

    # Redirect /blog/index.html to /blog/
    RewriteCond %{THE_REQUEST} \s+/blog/index\.html[\s?]
    RewriteRule ^blog/index\.html$ /blog/ [R=301,L]

    # Redirect legacy lowercase or extensionless URLs to their canonical pages
    RewriteRule ^contact/?$ /Contact.html [R=301,L,NC]
    RewriteRule ^about/?$ /About.html [R=301,L,NC]
    RewriteRule ^privacy-policy/?$ /Privacy-Policy.html [R=301,L,NC]
    RewriteRule ^terms-of-service/?$ /Terms-of-Service.html [R=301,L,NC]
    RewriteRule ^(products|services)/?$ / [R=301,L,NC]
    RewriteRule ^tools/terms-of-service\.html$ /Terms-of-Service.html [R=301,L,NC]
</IfModule>

# --- GZIP Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
